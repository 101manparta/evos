# EVOS Fleet Cost Intelligence Platform Environment Variables
APP_ENV=production
PORT=8080

# Supabase PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth & API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Token Secret for Session Verification
JWT_SECRET=your-secure-jwt-signing-secret-key-min-32-chars

# Redis-compatible Cache (Upstash / Local Redis)
REDIS_URL=rediss://default:your-token@your-upstash-redis.upstash.io:6379

# Allowed CORS Origins (Frontend application URLs)
CORS_ORIGINS=http://localhost:3000,https://app.evos-intelligence.com

# Fleet Default Currency & Location
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Makassar
